 // HandleAudioStream processes incoming user audio through the session's pipeline.
diff --git a/server/internal/orchestrator/external_avatar_audio.go b/server/internal/orchestrator/external_avatar_audio.go
new file mode 100644
index 0000000..44f04af
--- /dev/null
+++ b/server/internal/orchestrator/external_avatar_audio.go
@@ -0,0 +1,377 @@
+package orchestrator
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/cyberverse/server/internal/inference"
+	"github.com/cyberverse/server/internal/mediapeer"
+	"github.com/cyberverse/server/internal/pb"
+)
+
+// externalAvatarAudioStream is intentionally an internal CyberVerse session
+// primitive. It does not expose transport, token-signing, lip-sync, or avatar
+// state to the embedding application.
+type externalAvatarAudioStream struct {
+	replyID      string
+	nextSequence uint64
+	input        chan *pb.AudioChunk
+	cancel       context.CancelFunc
+	done         chan error
+	closed       bool
+}
+
+// avatarAVDriverOptions carries lifecycle-only callbacks into the one
+// CyberVerse-owned avatar AV driver. The driver itself remains authoritative
+// for avatar inference, AV sync, pacing and MediaPeer publication.
+type avatarAVDriverOptions struct {
+	Epoch        uint64
+	RequirePeer  bool
+	TraceLabel   func(int64) string
+	OnAudio      func([]byte, int)
+	OnFirstVideo func(int, int, int)
+	OnVideoChunk func([]byte)
+}
+
+func cloneExternalAudioChunk(chunk *pb.AudioChunk) *pb.AudioChunk {
+	if chunk == nil {
+		return nil
+	}
+	return &pb.AudioChunk{
+		Data:        append([]byte(nil), chunk.GetData()...),
+		SampleRate:  chunk.GetSampleRate(),
+		Channels:    chunk.GetChannels(),
+		Format:      chunk.GetFormat(),
+		IsFinal:     chunk.GetIsFinal(),
+		TimestampMs: chunk.GetTimestampMs(),
+	}
+}
+
+func (o *Orchestrator) avatarMediaPeer(sessionID string) mediapeer.MediaPeer {
+	o.mu.RLock()
+	defer o.mu.RUnlock()
+	return o.peers[sessionID]
+}
+
+// runAvatarAVDriver is the single non-silent CyberVerse AudioChunk -> avatar ->
+// paced RawAVSegment driver shared by standard TTS and external audio ingress.
+// Callers can observe audio/video lifecycle for recording/status only; they do
+// not own avatar inference, AV synchronization, pacing, or publication.
+func (o *Orchestrator) runAvatarAVDriver(ctx context.Context, sessionID string, input <-chan *pb.AudioChunk, options avatarAVDriverOptions) error {
+	if o == nil || o.inference == nil {
+		return errors.New("inference service is not configured")
+	}
+	if options.RequirePeer && o.avatarMediaPeer(sessionID) == nil {
+		return errors.New("media peer not found")
+	}
+
+	driverCtx, cancel := context.WithCancel(ctx)
+	defer cancel()
+
+	syncBuf := newVoiceAVSyncBuffer(voiceMaxPCMBufferSamples)
+	avatarInput := make(chan *pb.AudioChunk, 8)
+	feedDone := make(chan error, 1)
+	go func() {
+		defer close(avatarInput)
+		for {
+			select {
+			case <-driverCtx.Done():
+				feedDone <- driverCtx.Err()
+				return
+			case chunk, ok := <-input:
+				if !ok {
+					feedDone <- nil
+					return
+				}
+				pcm, sampleRate := audioChunkToPCM16(chunk)
+				if len(pcm) > 0 {
+					if options.OnAudio != nil {
+						options.OnAudio(pcm, sampleRate)
+					}
+					if dropped := syncBuf.appendPCM(pcm, sampleRate); dropped > 0 {
+						bufferedSamples, _, _, _ := syncBuf.snapshot()
+						log.Printf("avatar AV sync buffer overflow for session %s: dropped=%d bytes, buffered_samples=%d", sessionID, dropped, bufferedSamples)
+					}
+				}
+				select {
+				case avatarInput <- chunk:
+				case <-driverCtx.Done():
+					feedDone <- driverCtx.Err()
+					return
+				}
+			}
+		}
+	}()
+
+	o.avatarMu.Lock()
+	defer o.avatarMu.Unlock()
+	avatarCtx := inference.WithTraceContext(driverCtx, inference.TraceContext{SessionID: sessionID})
+	videoCh, videoErrCh := o.inference.GenerateAvatarStream(avatarCtx, avatarInput)
+
+	var (
+		segVideo        []byte
+		segFrames       int
+		segWidth        int
+		segHeight       int
+		segFPS          int
+		segCount        int
+		segSeq          int64
+		segMediaStartMS int64
+		firstFrameSent  bool
+	)
+	flush := func(isFinalSeg bool) error {
+		if segCount == 0 {
+			return nil
+		}
+		segSeq++
+		segDurationMS := durationMSForVideo(segFrames, segFPS)
+		if peer := o.avatarMediaPeer(sessionID); peer != nil {
+			segPCM, outSamples, wantSamples, bufferedSamplesAfterTake := syncBuf.takeSegmentPCM(segFrames, segFPS, isFinalSeg)
+			_, _, _, sampleRate := syncBuf.snapshot()
+			if sampleRate <= 0 {
+				sampleRate = 16000
+			}
+			if segSeq == 1 && outSamples < wantSamples {
+				bufferedSamples, _, _, _ := syncBuf.snapshot()
+				log.Printf("avatar AV drift for session %s: out_samples=%d want_samples=%d frames=%d fps=%d buffered_samples=%d",
+					sessionID, outSamples, wantSamples, segFrames, segFPS, bufferedSamples)
+			}
+			if isFinalSeg && bufferedSamplesAfterTake > 0 {
+				log.Printf("avatar AV strict trim tail session=%s: trimmed_samples=%d", sessionID, bufferedSamplesAfterTake)
+			}
+			traceLabel := ""
+			if options.TraceLabel != nil {
+				traceLabel = options.TraceLabel(segSeq)
+			}
+			raw := &mediapeer.RawAVSegment{
+				TraceLabel:   traceLabel,
+				Epoch:        options.Epoch,
+				SegmentSeq:   segSeq,
+				MediaStartMS: segMediaStartMS,
+				DurationMS:   segDurationMS,
+				RGB:          segVideo,
+				PCM:          segPCM,
+				SampleRate:   sampleRate,
+				Width:        segWidth,
+				Height:       segHeight,
+				FPS:          segFPS,
+				NumFrames:    segFrames,
+			}
+			if err := peer.SendAVSegment(raw); err != nil {
+				return err
+			}
+		} else if options.RequirePeer {
+			return errors.New("media peer not found")
+		}
+		segMediaStartMS += segDurationMS
+		segVideo = nil
+		segFrames = 0
+		segCount = 0
+		return nil
+	}
+
+	for {
+		select {
+		case <-driverCtx.Done():
+			_ = flush(false)
+			return driverCtx.Err()
+		case chunk, ok := <-videoCh:
+			if !ok {
+				if err := flush(true); err != nil {
+					return err
+				}
+				if err := <-videoErrCh; err != nil {
+					return err
+				}
+				cancel()
+				if feedErr := <-feedDone; feedErr != nil && !errors.Is(feedErr, context.Canceled) {
+					return feedErr
+				}
+				if ctx.Err() == nil {
+					if peer := o.avatarMediaPeer(sessionID); peer != nil {
+						peer.WaitAVDrain(10 * time.Second)
+					}
+				}
+				return nil
+			}
+			nf := int(chunk.GetNumFrames())
+			width, height := int(chunk.GetWidth()), int(chunk.GetHeight())
+			if nf <= 0 && width*height*3 > 0 {
+				nf = len(chunk.GetData()) / (width * height * 3)
+			}
+			fps := int(chunk.GetFps())
+			if fps <= 0 {
+				fps = 25
+			}
+			if !firstFrameSent {
+				firstFrameSent = true
+				if options.OnFirstVideo != nil {
+					options.OnFirstVideo(width, height, fps)
+				}
+			}
+			if options.OnVideoChunk != nil {
+				options.OnVideoChunk(chunk.GetData())
+			}
+			segVideo = append(segVideo, chunk.GetData()...)
+			segFrames += nf
+			segWidth = width
+			segHeight = height
+			segFPS = fps
+			segCount++
+			if segCount >= stdChunksPerSegment || chunk.GetIsFinal() {
+				if err := flush(chunk.GetIsFinal()); err != nil {
+					return err
+				}
+			}
+		}
+	}
+}
+
+// HandleExternalAvatarAudioChunk accepts already-synthesized audio while
+// preserving CyberVerse as the avatar/AV/LiveKit authority. Each reply starts
+// at sequence zero and subsequent chunks for that reply must be strictly
+// contiguous. Multiple finalized replies may drain concurrently at the
+// session level; avatarMu inside runAvatarAVDriver serializes avatar authority.
+func (o *Orchestrator) HandleExternalAvatarAudioChunk(ctx context.Context, sessionID, replyID string, sequence uint64, chunk *pb.AudioChunk) error {
+	if o == nil || o.inference == nil {
+		return errors.New("inference service is not configured")
+	}
+	if o.streamingMode != "livekit" {
+		return errors.New("external avatar audio requires CyberVerse livekit streaming mode")
+	}
+	if _, err := o.sessionMgr.Get(sessionID); err != nil {
+		return err
+	}
+	if !o.AvatarEnabled() {
+		return errors.New("avatar inference is disabled")
+	}
+	replyID = strings.TrimSpace(replyID)
+	if replyID == "" {
+		return errors.New("external audio reply id is required")
+	}
+	if chunk == nil || len(chunk.GetData()) == 0 || chunk.GetSampleRate() <= 0 || chunk.GetChannels() <= 0 {
+		return errors.New("invalid external audio chunk")
+	}
+	format := strings.ToLower(strings.TrimSpace(chunk.GetFormat()))
+	if format != "s16le" && format != "float32" {
+		return fmt.Errorf("unsupported external audio format %q", format)
+	}
+
+	o.externalAudioMu.Lock()
+	sessionStreams := o.externalAudio[sessionID]
+	if sessionStreams == nil {
+		sessionStreams = make(map[string]*externalAvatarAudioStream)
+		o.externalAudio[sessionID] = sessionStreams
+	}
+	stream := sessionStreams[replyID]
+	if stream == nil {
+		if sequence != 0 {
+			o.externalAudioMu.Unlock()
+			return errors.New("external audio stream must start at sequence zero")
+		}
+		streamCtx, cancel := context.WithCancel(context.Background())
+		stream = &externalAvatarAudioStream{
+			replyID: replyID,
+			input:   make(chan *pb.AudioChunk, 8),
+			cancel:  cancel,
+			done:    make(chan error, 1),
+		}
+		sessionStreams[replyID] = stream
+		go func(s *externalAvatarAudioStream, streamReplyID string) {
+			err := o.runExternalAvatarAudioStream(streamCtx, sessionID, streamReplyID, s.input)
+			s.done <- err
+			close(s.done)
+			o.externalAudioMu.Lock()
+			if streams := o.externalAudio[sessionID]; streams != nil && streams[streamReplyID] == s {
+				delete(streams, streamReplyID)
+				if len(streams) == 0 {
+					delete(o.externalAudio, sessionID)
+				}
+			}
+			o.externalAudioMu.Unlock()
+		}(stream, replyID)
+	}
+	if stream.closed {
+		o.externalAudioMu.Unlock()
+		return errors.New("external audio stream is already final")
+	}
+	if sequence != stream.nextSequence {
+		o.externalAudioMu.Unlock()
+		return fmt.Errorf("external audio sequence mismatch: got %d want %d", sequence, stream.nextSequence)
+	}
+	stream.nextSequence++
+	copyChunk := cloneExternalAudioChunk(chunk)
+	final := copyChunk.GetIsFinal()
+	if final {
+		stream.closed = true
+	}
+	o.externalAudioMu.Unlock()
+
+	select {
+	case stream.input <- copyChunk:
+	case err := <-stream.done:
+		if err == nil {
+			return errors.New("external avatar audio stream closed")
+		}
+		return err
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+	if final {
+		close(stream.input)
+	}
+	return nil
+}
+
+// StopExternalAvatarAudio is called by CyberVerse session deletion before the
+// existing TeardownSession path. It cancels every reply stream for the session,
+// is idempotent, and bounds the combined drain wait.
+func (o *Orchestrator) StopExternalAvatarAudio(sessionID string) {
+	if o == nil {
+		return
+	}
+	o.externalAudioMu.Lock()
+	sessionStreams := o.externalAudio[sessionID]
+	delete(o.externalAudio, sessionID)
+	streams := make([]*externalAvatarAudioStream, 0, len(sessionStreams))
+	for _, stream := range sessionStreams {
+		stream.closed = true
+		streams = append(streams, stream)
+	}
+	o.externalAudioMu.Unlock()
+	if len(streams) == 0 {
+		return
+	}
+	for _, stream := range streams {
+		stream.cancel()
+	}
+	timer := time.NewTimer(3 * time.Second)
+	defer timer.Stop()
+	for _, stream := range streams {
+		select {
+		case <-stream.done:
+		case <-timer.C:
+			return
+		}
+	}
+}
+
+// runExternalAvatarAudioStream delegates to the exact same CyberVerse avatar
+// AV driver as standard TTS. External ingress owns only session/reply ordering.
+func (o *Orchestrator) runExternalAvatarAudioStream(ctx context.Context, sessionID, replyID string, input <-chan *pb.AudioChunk) error {
+	return o.runAvatarAVDriver(ctx, sessionID, input, avatarAVDriverOptions{
+		RequirePeer: true,
+		TraceLabel: func(segSeq int64) string {
+			return voiceTraceLabel(sessionID, 0, replyID, "", segSeq)
+		},
+		OnFirstVideo: func(_, _, _ int) {
+			if session, err := o.sessionMgr.Get(sessionID); err == nil {
+				session.SetState(StateSpeaking)
+				o.broadcastStatus(sessionID, "speaking")
+			}
+		},
+	})
+}
