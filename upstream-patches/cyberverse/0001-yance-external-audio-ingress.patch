+func (r *Router) handleExternalAvatarAudio(w http.ResponseWriter, req *http.Request) {
+	id := req.PathValue("id")
+	session, err := r.sessionMgr.Get(id)
+	if err != nil {
+		writeJSON(w, http.StatusNotFound, ErrorResponse{Error: err.Error()})
+		return
+	}
+	if !r.authorizeKanshanSessionAccess(w, req, session) {
+		return
+	}
+	if r.orch == nil {
+		writeJSON(w, http.StatusServiceUnavailable, ErrorResponse{Error: "orchestrator unavailable"})
+		return
+	}
+
+	var body ExternalAvatarAudioRequest
+	if err := json.NewDecoder(req.Body).Decode(&body); err != nil {
+		writeJSON(w, http.StatusBadRequest, ErrorResponse{Error: "invalid JSON: " + err.Error()})
+		return
+	}
+	data, err := base64.StdEncoding.DecodeString(strings.TrimSpace(body.DataBase64))
+	format := strings.ToLower(strings.TrimSpace(body.Format))
+	if err != nil || len(data) == 0 || body.SampleRate <= 0 || body.Channels <= 0 || (format != "s16le" && format != "float32") {
+		writeJSON(w, http.StatusBadRequest, ErrorResponse{Error: "invalid external audio chunk"})
+		return
+	}
+	chunk := &pb.AudioChunk{
+		Data:        data,
+		SampleRate:  body.SampleRate,
+		Channels:    body.Channels,
+		Format:      format,
+		IsFinal:     body.IsFinal,
+		TimestampMs: body.TimestampMS,
+	}
+	if err := r.orch.HandleExternalAvatarAudioChunk(req.Context(), id, strings.TrimSpace(body.ReplyID), body.Sequence, chunk); err != nil {
+		writeJSON(w, http.StatusConflict, ErrorResponse{Error: err.Error()})
+		return
+	}
+	writeJSON(w, http.StatusAccepted, map[string]any{
+		"accepted": true,
+		"sequence": body.Sequence,
+		"is_final": body.IsFinal,
+	})
+}
