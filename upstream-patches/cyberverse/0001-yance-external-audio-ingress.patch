--- /dev/null
+++ b/server/internal/orchestrator/external_avatar_audio.go
@@ -0,0 +1,272 @@
+package orchestrator
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/cyberverse/server/internal/inference"
+	"github.com/cyberverse/server/internal/mediapeer"
+	"github.com/cyberverse/server/internal/pb"
+)
+
+// externalAvatarAudioStream is intentionally an internal CyberVerse session
+// primitive. It does not expose transport, token-signing, lip-sync, or avatar
+// state to the embedding application.
+type externalAvatarAudioStream struct {
+	replyID      string
+	nextSequence uint64
+	input        chan *pb.AudioChunk
+	cancel       context.CancelFunc
+	done         chan error
+	closed       bool
+}
+
+func cloneExternalAudioChunk(chunk *pb.AudioChunk) *pb.AudioChunk {
+	if chunk == nil {
+		return nil
+	}
+	return &pb.AudioChunk{
+		Data:        append([]byte(nil), chunk.GetData()...),
+		SampleRate:  chunk.GetSampleRate(),
+		Channels:    chunk.GetChannels(),
+		Format:      chunk.GetFormat(),
+		IsFinal:     chunk.GetIsFinal(),
+		TimestampMs: chunk.GetTimestampMs(),
+	}
+}
+
+// HandleExternalAvatarAudioChunk accepts already-synthesized audio while
+// preserving CyberVerse as the avatar/AV/LiveKit authority. A reply starts at
+// sequence zero and subsequent chunks must be strictly contiguous.
+func (o *Orchestrator) HandleExternalAvatarAudioChunk(ctx context.Context, sessionID, replyID string, sequence uint64, chunk *pb.AudioChunk) error {
+	if o == nil || o.inference == nil {
+		return errors.New("inference service is not configured")
+	}
+	if o.streamingMode != "livekit" {
+		return errors.New("external avatar audio requires CyberVerse livekit streaming mode")
+	}
+	if _, err := o.sessionMgr.Get(sessionID); err != nil {
+		return err
+	}
+	if !o.AvatarEnabled() {
+		return errors.New("avatar inference is disabled")
+	}
+	replyID = strings.TrimSpace(replyID)
+	if replyID == "" {
+		return errors.New("external audio reply id is required")
+	}
+	if chunk == nil || len(chunk.GetData()) == 0 || chunk.GetSampleRate() <= 0 || chunk.GetChannels() <= 0 {
+		return errors.New("invalid external audio chunk")
+	}
+	format := strings.ToLower(strings.TrimSpace(chunk.GetFormat()))
+	if format != "s16le" && format != "float32" {
+		return fmt.Errorf("unsupported external audio format %q", format)
+	}
+
+	o.externalAudioMu.Lock()
+	stream := o.externalAudio[sessionID]
+	if stream == nil {
+		if sequence != 0 {
+			o.externalAudioMu.Unlock()
+			return errors.New("external audio stream must start at sequence zero")
+		}
+		streamCtx, cancel := context.WithCancel(context.Background())
+		stream = &externalAvatarAudioStream{
+			replyID: replyID,
+			input:   make(chan *pb.AudioChunk, 8),
+			cancel:  cancel,
+			done:    make(chan error, 1),
+		}
+		o.externalAudio[sessionID] = stream
+		go func(s *externalAvatarAudioStream) {
+			err := o.runExternalAvatarAudioStream(streamCtx, sessionID, replyID, s.input)
+			s.done <- err
+			close(s.done)
+			o.externalAudioMu.Lock()
+			if o.externalAudio[sessionID] == s {
+				delete(o.externalAudio, sessionID)
+			}
+			o.externalAudioMu.Unlock()
+		}(stream)
+	}
+	if stream.replyID != replyID {
+		o.externalAudioMu.Unlock()
+		return errors.New("external audio reply changed before prior reply finished")
+	}
+	if stream.closed {
+		o.externalAudioMu.Unlock()
+		return errors.New("external audio stream is already final")
+	}
+	if sequence != stream.nextSequence {
+		o.externalAudioMu.Unlock()
+		return fmt.Errorf("external audio sequence mismatch: got %d want %d", sequence, stream.nextSequence)
+	}
+	stream.nextSequence++
+	copyChunk := cloneExternalAudioChunk(chunk)
+	final := copyChunk.GetIsFinal()
+	if final {
+		stream.closed = true
+	}
+	o.externalAudioMu.Unlock()
+
+	select {
+	case stream.input <- copyChunk:
+	case err := <-stream.done:
+		if err == nil {
+			return errors.New("external avatar audio stream closed")
+		}
+		return err
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+	if final {
+		close(stream.input)
+	}
+	return nil
+}
+
+// StopExternalAvatarAudio is called by CyberVerse session deletion before the
+// existing TeardownSession path. It is idempotent and bounded.
+func (o *Orchestrator) StopExternalAvatarAudio(sessionID string) {
+	if o == nil {
+		return
+	}
+	o.externalAudioMu.Lock()
+	stream := o.externalAudio[sessionID]
+	if stream != nil {
+		delete(o.externalAudio, sessionID)
+	}
+	o.externalAudioMu.Unlock()
+	if stream == nil {
+		return
+	}
+	stream.cancel()
+	select {
+	case <-stream.done:
+	case <-time.After(3 * time.Second):
+	}
+}
+
+// runExternalAvatarAudioStream uses the same CyberVerse-owned inference,
+// voiceAVSyncBuffer, RawAVSegment and MediaPeer primitives as the standard TTS
+// path. No corresponding AV driver exists in Yance.
+func (o *Orchestrator) runExternalAvatarAudioStream(ctx context.Context, sessionID, replyID string, input <-chan *pb.AudioChunk) error {
+	o.mu.RLock()
+	peer := o.peers[sessionID]
+	o.mu.RUnlock()
+	if peer == nil {
+		return errors.New("media peer not found")
+	}
+
+	syncBuf := newVoiceAVSyncBuffer(voiceMaxPCMBufferSamples)
+	avatarInput := make(chan *pb.AudioChunk, 8)
+	feedDone := make(chan error, 1)
+	go func() {
+		defer close(avatarInput)
+		for {
+			select {
+			case <-ctx.Done():
+				feedDone <- ctx.Err()
+				return
+			case chunk, ok := <-input:
+				if !ok {
+					feedDone <- nil
+					return
+				}
+				pcm, sampleRate := audioChunkToPCM16(chunk)
+				if len(pcm) > 0 {
+					syncBuf.appendPCM(pcm, sampleRate)
+				}
+				select {
+				case avatarInput <- chunk:
+				case <-ctx.Done():
+					feedDone <- ctx.Err()
+					return
+				}
+			}
+		}
+	}()
+
+	o.avatarMu.Lock()
+	defer o.avatarMu.Unlock()
+	avatarCtx := inference.WithTraceContext(ctx, inference.TraceContext{SessionID: sessionID})
+	videoCh, videoErrCh := o.inference.GenerateAvatarStream(avatarCtx, avatarInput)
+	var video []byte
+	var frames, width, height, fps, count int
+	var seq, mediaStartMS int64
+	flush := func(final bool) error {
+		if count == 0 {
+			return nil
+		}
+		duration := durationMSForVideo(frames, fps)
+		pcm, _, _, _ := syncBuf.takeSegmentPCM(frames, fps, final)
+		_, _, _, sampleRate := syncBuf.snapshot()
+		if sampleRate <= 0 {
+			sampleRate = 16000
+		}
+		seq++
+		raw := &mediapeer.RawAVSegment{
+			TraceLabel: voiceTraceLabel(sessionID, 0, replyID, "", seq),
+			SegmentSeq: seq, MediaStartMS: mediaStartMS, DurationMS: duration,
+			RGB: video, PCM: pcm, SampleRate: sampleRate,
+			Width: width, Height: height, FPS: fps, NumFrames: frames,
+		}
+		if err := peer.SendAVSegment(raw); err != nil {
+			return err
+		}
+		mediaStartMS += duration
+		video = nil
+		frames, count = 0, 0
+		return nil
+	}
+
+	firstVideo := true
+	for {
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case chunk, ok := <-videoCh:
+			if !ok {
+				if err := flush(true); err != nil {
+					return err
+				}
+				if err := <-videoErrCh; err != nil {
+					return err
+				}
+				if err := <-feedDone; err != nil && !errors.Is(err, context.Canceled) {
+					return err
+				}
+				peer.WaitAVDrain(10 * time.Second)
+				return nil
+			}
+			nf := int(chunk.GetNumFrames())
+			w, h := int(chunk.GetWidth()), int(chunk.GetHeight())
+			if nf <= 0 && w*h*3 > 0 {
+				nf = len(chunk.GetData()) / (w * h * 3)
+			}
+			chunkFPS := int(chunk.GetFps())
+			if chunkFPS <= 0 {
+				chunkFPS = 25
+			}
+			if firstVideo {
+				firstVideo = false
+				if session, err := o.sessionMgr.Get(sessionID); err == nil {
+					session.SetState(StateSpeaking)
+					o.broadcastStatus(sessionID, "speaking")
+				}
+			}
+			video = append(video, chunk.GetData()...)
+			frames += nf
+			width, height, fps = w, h, chunkFPS
+			count++
+			if count >= stdChunksPerSegment || chunk.GetIsFinal() {
+				if err := flush(chunk.GetIsFinal()); err != nil {
+					return err
+				}
+			}
+		}
+	}
+}
