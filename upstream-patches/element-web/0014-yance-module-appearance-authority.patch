+
+SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE files in the repository root for full details.
+*/
+
+/**
+ * A host appearance theme projected by a runtime module.
+ * @alpha Subject to change.
+ */
+export interface AppearanceTheme {
+    /** Stable caller-owned theme identity. */
+    id: string;
+    /** User-facing theme name. */
+    name: string;
+    /** Whether the theme should use Element's dark custom-theme base. */
+    isDark: boolean;
+    /** Existing Element custom-theme color variables. */
+    colors?: Record<string, string>;
+    /** Existing Element Compound design-token overrides. */
+    compound?: Record<string, string>;
+}
+
+/**
+ * Narrow API for applying host-wide appearance through Element's existing settings machinery.
+ * @alpha Subject to change.
+ */
+export interface AppearanceApi {
+    /** Apply an integer font scale from 85 through 150 percent. */
+    setFontScale(percent: number): Promise<void>;
+    /** Apply a custom theme through Element's existing custom theme capability. */
+    setTheme(theme: AppearanceTheme): Promise<void>;
+}
