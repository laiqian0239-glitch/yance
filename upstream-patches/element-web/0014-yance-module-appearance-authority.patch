+Please see LICENSE files in the repository root for full details.
+*/
+
+import type { Api } from "@element-hq/element-web-module-api";
+
+import SettingsStore from "../settings/SettingsStore";
+import { SettingLevel } from "../settings/SettingLevel";
+import { FontWatcher } from "../settings/watchers/FontWatcher";
+import dis from "../dispatcher/dispatcher";
+import { Action } from "../dispatcher/actions";
+import { type RecheckThemePayload } from "../dispatcher/payloads/RecheckThemePayload";
+
+type IAppearanceApi = Api["appearance"];
+type AppearanceThemeInput = Parameters<IAppearanceApi["setTheme"]>[0];
+
+const YANCE_THEME_PREFIX = "言策 · ";
+
+function assertFontScale(percent: number): void {
+    if (!Number.isInteger(percent) || percent < 85 || percent > 150) {
+        throw new Error("Appearance font scale must be an integer from 85 through 150");
+    }
+}
+
+function assertTheme(theme: AppearanceThemeInput): void {
+    if (!/^[a-z0-9][a-z0-9_-]{0,63}$/iu.test(theme.id)) {
+        throw new Error("Appearance theme id is invalid");
+    }
+    if (!theme.name.trim() || theme.name.length > 80) {
+        throw new Error("Appearance theme name is invalid");
+    }
+}
+
+export class AppearanceApi implements IAppearanceApi {
+    public async setFontScale(percent: number): Promise<void> {
+        assertFontScale(percent);
+
+        const browserDefaultFontSize = FontWatcher.getBrowserDefaultFontSize();
+        const delta = (browserDefaultFontSize * (percent - 100)) / 100;
+        await SettingsStore.setValue("fontSizeDelta", null, SettingLevel.DEVICE, delta);
+    }
+
+    public async setTheme(theme: AppearanceThemeInput): Promise<void> {
+        assertTheme(theme);
+
+        const elementThemeName = `${YANCE_THEME_PREFIX}${theme.name.trim()}`;
+        const currentThemes = SettingsStore.getValue("custom_themes") ?? [];
+        const retainedThemes = currentThemes.filter((entry) => !entry.name.startsWith(YANCE_THEME_PREFIX));
+        const customTheme = {
+            name: elementThemeName,
+            is_dark: theme.isDark,
+            ...(theme.colors ? { colors: theme.colors } : {}),
+            ...(theme.compound ? { compound: theme.compound } : {}),
+        };
+
+        await SettingsStore.setValue("custom_themes", null, SettingLevel.DEVICE, [...retainedThemes, customTheme]);
+        await SettingsStore.setValue("use_system_theme", null, SettingLevel.DEVICE, false);
+
+        const elementThemeId = `custom-${elementThemeName}`;
+        await SettingsStore.setValue("theme", null, SettingLevel.DEVICE, elementThemeId);
+        dis.dispatch<RecheckThemePayload>({ action: Action.RecheckTheme, forceTheme: elementThemeId });
+    }
+}
