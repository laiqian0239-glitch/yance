+    public getRecentMessageSummaries(limit = 12): RoomMessageSummary[] {
+        const boundedLimit = Math.max(1, Math.min(50, Math.floor(limit)));
+        const events = this.sdkRoom.getLiveTimeline().getEvents();
+        const summaries: RoomMessageSummary[] = [];
+        for (let index = events.length - 1; index >= 0 && summaries.length < boundedLimit; index -= 1) {
+            const event = events[index];
+            if (event.getType() !== "m.room.message") continue;
+            const content = event.getContent<Record<string, unknown>>();
+            const body = typeof content.body === "string" ? content.body.trim() : "";
+            if (!body) continue;
+            summaries.push({
+                id: event.getId() ?? "",
+                sender: event.getSender() ?? "",
+                body,
+                timestamp: event.getTs(),
+            });
+        }
+        return summaries;
+    }
