diff --git a/apps/web/src/components/structures/auth/PostLoginSecurityShell.test.tsx b/apps/web/src/components/structures/auth/PostLoginSecurityShell.test.tsx
new file mode 100644
index 0000000..d5dfac0
--- /dev/null
+++ b/apps/web/src/components/structures/auth/PostLoginSecurityShell.test.tsx
@@ -0,0 +1,174 @@
+/*
+Copyright 2026 Yance Contributors
+
+SPDX-License-Identifier: AGPL-3.0-only
+*/
+
+import React, { type ReactElement, type ReactNode } from "react";
+import { Glass } from "@vector-im/compound-web";
+import { logger } from "matrix-js-sdk/src/logger";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+import SdkConfig from "../../../SdkConfig";
+import { ModuleApi } from "../../../modules/Api";
+import { CustomComponentsApi } from "../../../modules/customComponentApi";
+import { Phase, SetupEncryptionStore } from "../../../stores/SetupEncryptionStore";
+import AuthPage from "../../views/auth/AuthPage";
+import CompleteSecurityBody from "../../views/auth/CompleteSecurityBody";
+import { InitialCryptoSetupDialog } from "../../views/dialogs/security/InitialCryptoSetupDialog";
+import CompleteSecurity from "./CompleteSecurity";
+import E2eSetup from "./E2eSetup";
+import SetupEncryptionBody from "./SetupEncryptionBody";
+
+type ContentProps = { content: ReactNode };
+type ChildrenProps = { children?: ReactNode };
+type AnyElement = ReactElement<Record<string, unknown> & ChildrenProps>;
+
+const makeSetupEncryptionStore = (phase: Phase): SetupEncryptionStore =>
+    ({
+        phase,
+        start: vi.fn(),
+        stop: vi.fn(),
+        on: vi.fn(),
+        off: vi.fn(),
+        skip: vi.fn(),
+    }) as unknown as SetupEncryptionStore;
+
+const asElement = (node: ReactNode): AnyElement => node as AnyElement;
+
+describe("post-login security module presentation seam", () => {
+    beforeEach(() => {
+        SdkConfig.reset();
+    });
+
+    afterEach(() => {
+        vi.restoreAllMocks();
+    });
+
+    it("uses Element's original presentation when no module renderer is registered", () => {
+        const api = new CustomComponentsApi();
+        const content = <span data-testid="mature-security-content" />;
+        const originalComponent = vi.fn(({ content: inner }: ContentProps) => (
+            <div data-testid="element-security-fallback">{inner}</div>
+        ));
+
+        const output = api.renderPostLoginSecurity({ content }, originalComponent);
+
+        expect(originalComponent).toHaveBeenCalledTimes(1);
+        expect(originalComponent).toHaveBeenCalledWith({ content });
+        expect(output.props["data-testid"]).toBe("element-security-fallback");
+        expect(output.props.children).toBe(content);
+    });
+
+    it("falls back to Element's original presentation when a module renderer throws", () => {
+        const api = new CustomComponentsApi();
+        const content = <span data-testid="mature-security-content" />;
+        const originalComponent = vi.fn(({ content: inner }: ContentProps) => (
+            <div data-testid="element-security-fallback">{inner}</div>
+        ));
+        vi.spyOn(logger, "warn").mockImplementation(() => undefined);
+        api.registerPostLoginSecurityComponent(() => {
+            throw new Error("module renderer failure");
+        });
+
+        const output = api.renderPostLoginSecurity({ content }, originalComponent);
+
+        expect(originalComponent).toHaveBeenCalledTimes(1);
+        expect(output.props["data-testid"]).toBe("element-security-fallback");
+        expect(output.props.children).toBe(content);
+    });
+
+    it("passes Element-owned content to a registered module renderer", () => {
+        const api = new CustomComponentsApi();
+        const content = <span data-testid="mature-security-content" />;
+        const originalComponent = vi.fn(({ content: inner }: ContentProps) => <div>{inner}</div>);
+        let received: ReactNode;
+        api.registerPostLoginSecurityComponent((props) => {
+            received = props.content;
+            return <section data-testid="product-security-shell">{props.content}</section>;
+        });
+
+        const output = api.renderPostLoginSecurity({ content }, originalComponent);
+
+        expect(received).toBe(content);
+        expect(originalComponent).not.toHaveBeenCalled();
+        expect(output.props["data-testid"]).toBe("product-security-shell");
+        expect(output.props.children).toBe(content);
+    });
+
+    it("keeps CompleteSecurity's exact AuthPage/Glass fallback and mature SetupEncryptionBody", () => {
+        const store = makeSetupEncryptionStore(Phase.Busy);
+        vi.spyOn(SetupEncryptionStore, "sharedInstance").mockReturnValue(store);
+        const customComponents = ModuleApi.instance.customComponents;
+        vi.spyOn(customComponents, "renderPostLoginSecurity").mockImplementation((props, originalComponent) =>
+            originalComponent(props),
+        );
+
+        const output = new CompleteSecurity({ onFinished: vi.fn() }).render() as ReactElement<
+            ChildrenProps & { addBlur?: boolean }
+        >;
+
+        expect(output.type).toBe(AuthPage);
+        expect(output.props.addBlur).toBe(false);
+        const glass = asElement(output.props.children);
+        expect(glass.type).toBe(Glass);
+        const securityBody = asElement(glass.props.children);
+        expect(securityBody.type).toBe(CompleteSecurityBody);
+        const bodyChildren = React.Children.toArray(securityBody.props.children);
+        const body = asElement(bodyChildren[1]);
+        const setupEncryption = asElement(body.props.children);
+        expect(setupEncryption.type).toBe(SetupEncryptionBody);
+        expect(setupEncryption.props.allowLogout).toBe(true);
+    });
+
+    it("passes CompleteSecurity's mature inner content to the registered presentation seam", () => {
+        const store = makeSetupEncryptionStore(Phase.Busy);
+        vi.spyOn(SetupEncryptionStore, "sharedInstance").mockReturnValue(store);
+        let received: ReactNode;
+        vi.spyOn(ModuleApi.instance.customComponents, "renderPostLoginSecurity").mockImplementation((props) => {
+            received = props.content;
+            return <section data-testid="product-security-shell">{props.content}</section>;
+        });
+
+        const output = new CompleteSecurity({ onFinished: vi.fn() }).render() as AnyElement;
+        const securityBody = asElement(received!);
+
+        expect(output.props["data-testid"]).toBe("product-security-shell");
+        expect(securityBody.type).toBe(CompleteSecurityBody);
+        const bodyChildren = React.Children.toArray(securityBody.props.children);
+        const body = asElement(bodyChildren[1]);
+        expect(asElement(body.props.children).type).toBe(SetupEncryptionBody);
+    });
+
+    it("keeps E2eSetup's exact AuthPage fallback", () => {
+        vi.spyOn(ModuleApi.instance.customComponents, "renderPostLoginSecurity").mockImplementation(
+            (props, originalComponent) => originalComponent(props),
+        );
+
+        const output = new E2eSetup({ onCancelled: vi.fn() }).render() as AnyElement;
+        const securityBody = asElement(output.props.children);
+        const dialog = asElement(securityBody.props.children);
+
+        expect(output.type).toBe(AuthPage);
+        expect(securityBody.type).toBe(CompleteSecurityBody);
+        expect(dialog.type).toBe(InitialCryptoSetupDialog);
+    });
+
+    it("passes E2eSetup's real InitialCryptoSetupDialog through the same presentation seam", () => {
+        let received: ReactNode;
+        vi.spyOn(ModuleApi.instance.customComponents, "renderPostLoginSecurity").mockImplementation((props) => {
+            received = props.content;
+            return <section data-testid="product-security-shell">{props.content}</section>;
+        });
+        const onCancelled = vi.fn();
+
+        const output = new E2eSetup({ onCancelled }).render() as AnyElement;
+        const securityBody = asElement(received!);
+        const dialog = asElement(securityBody.props.children);
+
+        expect(output.props["data-testid"]).toBe("product-security-shell");
+        expect(securityBody.type).toBe(CompleteSecurityBody);
+        expect(dialog.type).toBe(InitialCryptoSetupDialog);
+        expect(dialog.props.onCancelled).toBe(onCancelled);
+    });
+});
