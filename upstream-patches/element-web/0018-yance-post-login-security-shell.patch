+    private _postLoginSecurityRenderer?: CustomPostLoginSecurityRenderFunction;
+
+    /**
+     * Register a Product presentation renderer for Element-owned post-login security content.
+     * The Matrix security lifecycle remains owned by the calling Element components.
+     */
+    public registerPostLoginSecurityComponent(renderer: CustomPostLoginSecurityRenderFunction): void {
+        this._postLoginSecurityRenderer = renderer;
+    }
+
+    /**
+     * Render Element-owned security content through a Product presentation seam.
+     * Missing or throwing module renderers fail safely back to Element's original AuthPage shell.
+     */
+    public renderPostLoginSecurity(
+        props: CustomPostLoginSecurityComponentProps,
+        originalComponent: (props: CustomPostLoginSecurityComponentProps) => React.JSX.Element,
+    ): React.JSX.Element {
+        const renderer = this._postLoginSecurityRenderer;
+        if (renderer) {
+            try {
+                return renderer(props);
+            } catch (ex) {
+                logger.warn("Post-login security renderer failed to render", ex);
+            }
+        }
+        return originalComponent(props);
+    }
+
     public registerComposerPreview(
