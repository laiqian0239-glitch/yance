+    public getRoomInviteSender(roomId: string): string | null {
+        const canonicalRoomId = String(roomId || "").trim();
+        if (!canonicalRoomId) return null;
+        const client = MatrixClientPeg.safeGet();
+        const userId = String(client.getUserId() || "").trim();
+        const room = client.getRoom(canonicalRoomId);
+        if (!userId || !room || room.getMyMembership() !== "invite") return null;
+        const event = room.currentState.getStateEvents("m.room.member", userId);
+        return event?.getSender() || null;
+    }
