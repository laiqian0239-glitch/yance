{
  "manifest_version": 3,
  "name": "言策网页伴侣 · Facebook",
  "short_name": "言策网页伴侣",
  "description": "用户主动从 Meta Business Suite 补全联系人头像，并预览会话与最近消息差异。",
  "version": "1.1.0",
  "version_name": "Fix21 2026-07-24",
  "key": "",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": [
    "https://business.facebook.com/*",
    "https://*.fbcdn.net/*",
    "https://*.facebook.com/*",
    "https://*.fbsbx.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": { "service_worker": "service-worker.js" },
  "action": {
    "default_title": "言策网页伴侣",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://business.facebook.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
