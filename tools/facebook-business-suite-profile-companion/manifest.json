{
  "manifest_version": 3,
  "name": "言策网页资料伴侣 · Facebook",
  "short_name": "言策资料伴侣",
  "description": "从用户已登录的 Meta Business Suite 当前页面零点击补全 Facebook Page 联系人姓名与头像。",
  "version": "1.0.0",
  "key": "",
  "permissions": ["tabs"],
  "host_permissions": [
    "https://business.facebook.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [
    {
      "matches": ["https://business.facebook.com/*"],
      "js": ["profile-extractor.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
