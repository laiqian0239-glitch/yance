{
  "schemaVersion": 1,
  "documentType": "YANCE_AUTHORITY_AND_WRITER_MATRIX",
  "identityContract": [
    "platform",
    "sourceAccountId",
    "platformContactIdentity",
    "conversationId",
    "canonicalContactId"
  ],
  "domains": [
    {
      "id": "replyLanguage",
      "authority": "ConversationLanguageAuthority",
      "currentImplementation": "backend/services/contactLanguageAuthority.js + backend/services/replyLanguageAuthority.js",
      "singleWriter": "contactLanguageAuthority writes conversation observation/override; replyLanguageAuthority resolves one effective target and validates generation/approval/revision/send",
      "storage": "contacts.payload_json.languageProfilesByScope[scopeKey]",
      "readers": [
        "backend/services/contextAwareReplyBrain.js",
        "backend/routes/store.js",
        "backend/store/commands/registerAiReplyCommands.js"
      ],
      "requiredStates": ["unknown", "observed", "user_locked", "conflicted", "validated", "blocked_mismatch"],
      "rootCauseRisks": [
        "最新入站语言、人工锁定和陈旧画像优先级不一致",
        "候选生成、审批、改写和发送前使用不同语言判断",
        "中文回译被误当成候选原文"
      ],
      "sourceReferences": [
        "backend/services/contactLanguageAuthority.js",
        "backend/services/replyLanguageAuthority.js",
        "backend/services/contextAwareReplyBrain.js",
        "backend/routes/store.js"
      ]
    },
    {
      "id": "translation",
      "authority": "TranslationStateAuthority",
      "currentImplementation": "backend/services/messageTranslationService.js",
      "singleWriter": "MessageTranslationService translation job transition",
      "storage": "r32_messages translation fields + translation job registry",
      "readers": [
        "backend/routes/store.js",
        "backend/services/socialAnalysisPresentationService.js"
      ],
      "requiredStates": ["not_requested", "pending", "success", "failed", "cancelled", "superseded"],
      "rootCauseRisks": [
        "会话译文与客户档案/关系投影分裂",
        "待生成状态未被成功译文收敛"
      ],
      "sourceReferences": [
        "backend/services/messageTranslationService.js",
        "backend/services/bilingualUnderstandingService.js",
        "backend/routes/store.js",
        "backend/services/socialAnalysisPresentationService.js"
      ]
    },
    {
      "id": "modelRuntime",
      "authority": "ModelRuntimeAuthority",
      "currentImplementation": "backend/services/modelRuntimeAuthority.js + backend/services/modelRegistry.js + backend/services/modelStatusProjection.js",
      "singleWriter": "modelRegistry separately records qualification facts, business invocation facts and last successful invocation; ModelRuntimeAuthority is the only runtime projection",
      "storage": "model registry durable state",
      "readers": [
        "backend/services/modelStatusService.js",
        "backend/services/aiGateway.js",
        "backend/services/systemCenterService.js"
      ],
      "requiredStates": [
        "UNCONFIGURED", "CREDENTIAL_REQUIRED", "VERIFYING", "CONFIGURED_UNVERIFIED", "VERIFIED_NOT_CALLED", "AVAILABLE", "DEGRADED_WITH_FALLBACK", "TEMPORARILY_BLOCKED", "UNAVAILABLE"
      ],
      "rootCauseRisks": [
        "资格、路由、当前失败和最后成功由不同投影解释",
        "同一模型卡显示互相矛盾状态"
      ],
      "sourceReferences": [
        "backend/services/modelRuntimeAuthority.js",
        "backend/services/modelRegistry.js",
        "backend/services/modelStatusProjection.js",
        "backend/services/modelStatusService.js",
        "backend/services/aiGateway.js",
        "backend/services/systemCenterService.js"
      ]
    },
    {
      "id": "customerProfile",
      "authority": "CustomerProfileAuthority",
      "currentImplementation": "backend/services/customerProfileEvidenceAuthority.js + backend/repositories/workspaceRepository.js",
      "singleWriter": "CustomerProfileEvidenceAuthority resolves source-message translation and writes the account-scoped SQLite evidence projection inside the analysis transaction",
      "storage": "customer_profile_evidence unique projection + canonical customer_profiles source document",
      "readers": [
        "backend/routes/store.js",
        "backend/services/socialAnalysisPresentationService.js",
        "integration/element-module/src/product-experience/PeopleSurface.tsx"
      ],
      "requiredStates": ["empty", "collecting", "ready", "stale", "rebuild_required"],
      "rootCauseRisks": [
        "同一证据重复写入",
        "会话已有译文但档案仍待中文理解"
      ],
      "sourceReferences": [
        "backend/services/customerProfileEvidenceAuthority.js",
        "backend/services/socialAnalysisPresentationService.js",
        "backend/repositories/workspaceRepository.js",
        "backend/lib/r32SqliteStore.js",
        "integration/element-module/src/product-experience/PeopleSurface.tsx"
      ]
    },
    {
      "id": "relationshipProjection",
      "authority": "RelationshipProjectionAuthority",
      "currentImplementation": "backend/services/relationshipProjectionAuthority.js + backend/repositories/workspaceRepository.js",
      "singleWriter": "RelationshipProjectionAuthority owns the current relationship projection contract; source transactions write insights, social state, signals and timeline events. The remaining local ruleProjection fallback is a separately tracked successor gap and is not presented as Product UI authority.",
      "storage": "relationship_insights + customer_social_state + relationship_state_signals + relationship_timeline_events; Element receives one derived Product projection",
      "readers": [
        "backend/services/workspaceService.js",
        "backend/routes/workspace.js",
        "integration/element-module/src/product-experience/experienceProjection.ts",
        "integration/element-module/src/product-experience/RelationshipWorld.tsx"
      ],
      "requiredStates": ["empty", "pending_translation", "pending_analysis", "ready", "stale", "rebuild_required"],
      "rootCauseRisks": [
        "同一消息重复生成关系事件",
        "有效节点存在但摘要长期待分析",
        "多个正式渲染器自行覆盖关系结论"
      ],
      "sourceReferences": [
        "backend/services/relationshipProjectionAuthority.js",
        "backend/repositories/workspaceRepository.js",
        "backend/services/workspaceService.js",
        "integration/element-module/src/product-experience/experienceProjection.ts",
        "integration/element-module/src/product-experience/RelationshipWorld.tsx"
      ]
    },
    {
      "id": "learningLifecycle",
      "authority": "LearningV4ImmutableSignalLedger",
      "currentImplementation": "backend/services/replyFeedbackLearningService.js + backend/services/learningOutcomeAttributionService.js + backend/services/learningDataPolicy.js + backend/services/learningEvidenceBridge.js + backend/repositories/platformCoreRepository.js",
      "singleWriter": "Learning V4 uses one immutable learning_signal_ledger authority: replyFeedbackLearningService appends transaction-bound candidate feedback signals, learningOutcomeAttributionService appends permanently false-eligible raw outcome observations, and Learning-approved Langfuse evidence governs later trainable use.",
      "storage": "learning_signal_ledger + Learning-approved Langfuse evidence; no mutable reply-learning scope authority",
      "readers": [
        "backend/services/contextAwareReplyBrain.js",
        "backend/services/learningOutcomeAttributionService.js",
        "backend/services/learningEvidenceBridge.js"
      ],
      "requiredStates": [
        "candidate_sent",
        "candidate_rejected",
        "policy_outcome_observed",
        "scored",
        "shadowed",
        "promoted",
        "rolled_back"
      ],
      "rootCauseRisks": [
        "不可变候选与结果证据被误当成可原地修改的学习状态",
        "原始 outcome 被错误提升为 learningEligible",
        "退役 reply-learning scope authority 被重新当成正式真相源"
      ],
      "sourceReferences": [
        "backend/services/replyFeedbackLearningService.js",
        "backend/services/learningOutcomeAttributionService.js",
        "backend/services/learningDataPolicy.js",
        "backend/services/learningEvidenceBridge.js",
        "backend/repositories/platformCoreRepository.js",
        "backend/services/contextAwareReplyBrain.js"
      ]
    },
    {
      "id": "systemHealth",
      "authority": "SystemHealthAuthority",
      "currentImplementation": "backend/services/systemHealthAuthority.js + backend/services/systemCenterService.js",
      "singleWriter": "SystemHealthAuthority aggregates bounded runtime logs and projects one health state/score; systemCenterService only supplies probes, integrity and runtime facts",
      "storage": "derived runtime projection with bounded active/recent/historical error aggregates; no renderer-local health truth",
      "readers": ["backend/routes/system.js"],
      "requiredStates": ["healthy", "degraded", "blocked", "recovering", "unknown"],
      "rootCauseRisks": [
        "健康 100 与当前错误并存",
        "陈旧失败永久污染或当前失败被掩盖"
      ],
      "sourceReferences": [
        "backend/services/systemHealthAuthority.js",
        "backend/services/systemCenterService.js",
        "backend/routes/system.js"
      ]
    },
    {
      "id": "accountRuntime",
      "authority": "AccountRuntimeAuthority",
      "currentImplementation": "backend/services/accountDiagnosticPolicy.js + account manager runtime",
      "singleWriter": "account runtime/diagnostic reconciliation",
      "storage": "r32_accounts runtime projection and diagnostic results",
      "readers": ["backend/services/systemCenterService.js"],
      "requiredStates": ["disconnected", "connecting", "connected", "degraded", "reauth_required", "blocked"],
      "rootCauseRisks": [
        "已连接与等待真实连接确认同时显示",
        "诊断和账号中心使用不同快照"
      ],
      "sourceReferences": [
        "backend/services/accountDiagnosticPolicy.js",
        "backend/services/systemCenterService.js"
      ]
    },
    {
      "id": "backgroundJobs",
      "authority": "BackgroundJobAuthority",
      "currentImplementation": "backend/services/backgroundJobAuthority.js + avatarService + whatsappHistoryMediaRecovery",
      "singleWriter": "BackgroundJobAuthority atomically owns durable job state, attempts, retry timing, leases and final outcomes; worker services only execute acquired leases",
      "storage": "background_job_state SQLite table with unique idempotency_key",
      "readers": [
        "backend/services/avatarService.js",
        "backend/services/whatsappHistoryMediaRecovery.js",
        "backend/services/systemCenterService.js"
      ],
      "requiredStates": ["PENDING", "RUNNING", "SUCCEEDED", "RETRY_WAIT", "FAILED_FINAL", "CANCELLED", "SUPERSEDED"],
      "rootCauseRisks": [
        "进程重启后丢失内存锁并重复执行",
        "相同失败每次刷新都重新记录",
        "不可重试任务没有最终状态",
        "同一平台消息ID跨账号串任务"
      ],
      "sourceReferences": [
        "backend/services/backgroundJobAuthority.js",
        "backend/services/avatarService.js",
        "backend/services/whatsappHistoryMediaRecovery.js",
        "backend/lib/r32SqliteStore.js",
        "backend/services/systemHealthAuthority.js"
      ]
    },
    {
      "id": "notificationSound",
      "authority": "NotificationSoundAuthority",
      "currentImplementation": "shared/notificationSoundCatalog.js + backend/services/notificationPolicy.js + electron/SoundNotificationService.js",
      "singleWriter": "NotificationSoundAuthority owns the official Yance Classic catalog and event-to-setting mapping; notificationPolicy persists settings and SoundNotificationService only plays the selected authority pattern",
      "storage": "notification-settings SQLite document with catalog ids; user custom UUID sounds remain separate user-owned assets",
      "readers": [
        "backend/routes/system.js",
        "backend/services/systemCenterService.js",
        "electron/SoundNotificationService.js",
        "electron/sound-player.js"
      ],
      "requiredStates": ["enabled", "disabled", "selected", "previewing", "played", "failed"],
      "rootCauseRisks": [
        "前端、后端和 Electron 各自维护不同声音目录",
        "同一配置在多个正式页面形成平行写入入口",
        "来源不明的品牌音效被误当正式内置分发资产"
      ],
      "sourceReferences": [
        "shared/notificationSoundCatalog.js",
        "backend/services/notificationPolicy.js",
        "backend/routes/system.js",
        "electron/SoundNotificationService.js",
        "electron/sound-player.js",
        "governance/notification-sound-kenney-interface-sounds-20260816.json"
      ]
    },
    {
      "id": "businessPresentation",
      "authority": "BusinessPresentationAuthority",
      "currentImplementation": "backend/services/socialAnalysisPresentationService.js + integration/element-module/src/product-experience/experienceProjection.ts + Element Product renderers",
      "singleWriter": "Backend presentation services project localized business meaning while the Element Product projection adapts authoritative data for the sole Product renderer; routing/storage technical identities remain unchanged and are not re-authored by the UI",
      "storage": "authoritative backend business data plus source-versioned Element Product projection; no legacy frontend presentation authority",
      "readers": [
        "integration/element-module/src/product-experience/PeopleSurface.tsx",
        "integration/element-module/src/product-experience/RelationshipWorld.tsx",
        "integration/element-module/src/product-experience/ProductExperienceShell.tsx"
      ],
      "requiredStates": ["business_summary", "localized_label", "masked_identity", "technical_details", "routing_identity_unchanged"],
      "rootCauseRisks": [
        "正式页面直接显示内部枚举",
        "业务卡片直接显示底层技术身份",
        "为了隐藏技术 ID 误改底层发送路由身份"
      ],
      "sourceReferences": [
        "backend/services/socialAnalysisPresentationService.js",
        "integration/element-module/src/product-experience/experienceProjection.ts",
        "integration/element-module/src/product-experience/PeopleSurface.tsx",
        "integration/element-module/src/product-experience/RelationshipWorld.tsx",
        "integration/element-module/src/product-experience/ProductExperienceShell.tsx"
      ]
    }
  ],
  "rules": [
    "每个领域只能有一个权威状态投影",
    "UI 不得自行组合多个布尔字段产生业务状态",
    "写入者必须在数据库事务或明确的原子状态转换中工作",
    "跨平台客户档案关联不得合并底层会话、草稿、翻译、学习和发送路由",
    "姓名和头像不得成为身份关联或合并依据",
    "Element 是唯一 Product renderer；legacy frontend 只能作为历史源码存在，不得再被列为当前 reader 或 authority"
  ]
}
