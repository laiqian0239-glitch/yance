{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yance.local/schemas/mature-authority-audit-evidence-v1.json",
  "title": "Yance Mature Authority Audit Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "phase",
    "status",
    "auditId",
    "capability",
    "manifestPath",
    "manifestSha256",
    "checkedAt",
    "checks",
    "violations",
    "scan"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": {
      "enum": [
        "yance-mature-authority-admission",
        "yance-mature-authority-proof"
      ]
    },
    "phase": { "enum": ["admission", "proof"] },
    "status": { "enum": ["GREEN", "RED"] },
    "auditId": { "type": ["string", "null"] },
    "capability": { "type": ["string", "null"] },
    "manifestPath": { "type": ["string", "null"] },
    "manifestSha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "checkedAt": { "type": "string", "format": "date-time" },
    "admissionEvidencePath": { "type": "string" },
    "admissionEvidenceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "detail"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASS", "FAIL"] },
          "detail": { "type": "string" }
        }
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "file": { "type": "string" }
        }
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "builtInPatterns", "additionalPatterns"],
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "role", "sha256", "bytes"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "role": { "enum": ["integration", "owner"] },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "bytes": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "builtInPatterns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "additionalPatterns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "const": "yance-mature-authority-proof" } },
        "required": ["kind"]
      },
      "then": {
        "required": ["admissionEvidencePath", "admissionEvidenceSha256"]
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "GREEN" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "auditId": { "type": "string", "minLength": 1 },
          "capability": { "type": "string", "minLength": 1 },
          "manifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "violations": { "maxItems": 0 },
          "checks": {
            "items": {
              "properties": { "status": { "const": "PASS" } },
              "required": ["status"]
            }
          }
        }
      }
    }
  ]
}
