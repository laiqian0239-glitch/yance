{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yance.local/schemas/issue-comments-read-only-snapshot-v1.json",
  "title": "Read-only GitHub Issue Comments Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "issue", "export", "comments"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "url"],
      "properties": {
        "number": { "const": 1051 },
        "url": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/issues/1051$" }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "exportedAt", "paginationComplete", "pageCount", "commentCount"],
      "properties": {
        "source": { "const": "GITHUB_ISSUE_COMMENTS_READ_ONLY_EXPORT" },
        "exportedAt": { "type": "string", "format": "date-time" },
        "paginationComplete": { "const": true },
        "pageCount": { "type": "integer", "minimum": 1 },
        "commentCount": { "type": "integer", "minimum": 1 }
      }
    },
    "comments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "url", "createdAt", "updatedAt", "body"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/issues/1051#issuecomment-[0-9]+$" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "body": { "type": "string" }
        }
      }
    }
  }
}
