{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "yance-element-module",
  "projectType": "library",
  "targets": {
    "build": {
      "cache": true,
      "command": "vite build",
      "inputs": ["src"],
      "outputs": ["{projectRoot}/lib"],
      "options": { "cwd": "modules/yance" },
      "dependsOn": ["^build"]
    },
    "lint:types": {
      "command": "tsc --noEmit",
      "options": { "cwd": "modules/yance" },
      "dependsOn": ["^build"]
    }
  }
}
